.DS_Store
**/.DS_Store

# Authentication and cloud-provider state
.config/gcloud/
.config/gh/hosts.yml

# Machine-local Agent Toolbox settings (copy from the tracked example)
.config/agent-toolbox/agent-sandbox.env
.config/agent-toolbox/compose.mounts.yaml

# Machine-generated application state
.config/cagent/
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/.plugins.lock
.config/herdr/session.json
.config/zed/prompts/
