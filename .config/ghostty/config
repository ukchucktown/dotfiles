theme="subliminal-nightfall-fuzzy.conf"
background-opacity=0.90
background-blur=true
unfocused-split-opacity=0.84
unfocused-split-fill=#03021a
split-divider-color=#2b2e48
macos-option-as-alt=true
#macos-titlebar-style=tabs
window-decoration=false
macos-window-shadow=true
shell-integration=zsh
quick-terminal-position=top
quick-terminal-screen=mouse
quick-terminal-size=50%
quick-terminal-animation-duration=0
window-save-state=never
window-inherit-working-directory=false
working-directory=home
window-padding-x=20,10
window-padding-y=20,10

# key bindings
keybind=global:cmd+grave_accent=toggle_quick_terminal

# Opacity tweak hotkeys: send escape sequences to the shell
keybind=cmd+shift+equal=text:\x1b[201~
keybind=cmd+shift+minus=text:\x1b[202~

# Override default "Cmd+Number" tab selection shortcuts so macOS doesn't show them
keybind=cmd+1=unbind
keybind=cmd+2=unbind
keybind=cmd+3=unbind
keybind=cmd+4=unbind
keybind=cmd+5=unbind
keybind=cmd+6=unbind
keybind=cmd+7=unbind
keybind=cmd+8=unbind
keybind=cmd+9=unbind

# Split navigation for mouse button mappings
keybind=cmd+alt+]=goto_split:next
keybind=cmd+alt+[=goto_split:previous
